# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Optional: connection for code without a logged-in user (webhooks, workers, schedulers, login).
# Falls back to DATABASE_URL. Needed once RLS is enforced, see packages/db/README.md.
# DATABASE_SYSTEM_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Days to keep processed webhook events (worker cleanup job). Default 90.
# WEBHOOK_EVENT_RETENTION_DAYS=90

# JWT
JWT_SECRET=change_this_jwt_secret_minimum_32_characters
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change_this_encryption_key_minimum_32_characters

# Redis
REDIS_URL=redis://:password@redis-host:6379

# Frontend URL (for CORS, email links)
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGIN=https://your-frontend-domain.com
PUBLIC_API_URL=https://your-api-domain.com

# Sentry (optional)
SENTRY_DSN=

# Phone OTP (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# AmoCRM integration (token mode)
AMOCRM_BASE_URL=https://www.amocrm.ru
AMOCRM_WEBHOOK_SECRET=
AMOCRM_LONG_LIVED_TOKEN=

# Telegram integration
TELEGRAM_BOT_TOKEN=

# UTeL integration
UTEL_WEBHOOK_SECRET=

# Runtime
NODE_ENV=production
PORT=3001
SKIP_ENV_VALIDATION=false
