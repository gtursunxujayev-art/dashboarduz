// Multi-Tenant CRM Integrator Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enable Row Level Security (RLS) for all tables
// Run: ALTER TABLE table_name ENABLE ROW LEVEL SECURITY;
// Then create policies for each table

// ============================================
// TENANT & USER MANAGEMENT
// ============================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String?  @unique
  plan      String   @default("free") // free, pro, enterprise
  settings  Json?    // tenant-specific settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  integrations    Integration[]
  telegramRecipients TelegramRecipient[]
  leads           Lead[]
  contacts        Contact[]
  calls           Call[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  webhookEvents   WebhookEvent[]
  customers       Customer[]
  courses         Course[]
  tariffs         Tariff[]
  subTariffs      SubTariff[]
  incomes         Income[]
  incomeAdjustmentRequests IncomeAdjustmentRequest[]
  historicalImportSessions HistoricalImportSession[]
  corporateCallDurations CorporateCallDuration[]
  attendanceEvents AttendanceEvent[]
  attendanceDaySummaries AttendanceDaySummary[]
  attendanceAdjustments AttendanceAdjustment[]
  attendanceAdjustmentAudits AttendanceAdjustmentAudit[]
  metaAdInsights MetaAdInsight[]
  analyticsAiReports AnalyticsAiReport[]
  bonusPolicyVersions BonusPolicyVersion[]
  bonusMonthSnapshots BonusMonthSnapshot[]
  bonusAdjustments BonusAdjustment[]
  bonusReconcileRequests BonusReconcileRequest[]
  bonusAdjustmentAudits BonusAdjustmentAudit[]
  bonusAdjustmentApplications BonusAdjustmentApplication[]
  amocrmTasks AmocrmTask[]
  amocrmEvents AmocrmEvent[]
  amocrmReferences AmocrmReference[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  username     String?  @unique
  email        String?
  phone        String?
  passwordHash String?
  name         String?
  roles        String[] @default(["Agent"]) // Admin, Manager, Agent, Finance
  authProvider String   // phone, telegram, email
  providerId   String?  // external provider ID
  telegramId   String?  @unique
  amocrmResponsibleUserId String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]
  linkedAccounts UserAuthLink[]
  managedIncomes Income[] @relation("IncomeManager")
  requestedIncomeAdjustments IncomeAdjustmentRequest[] @relation("IncomeAdjustmentRequestedBy")
  reviewedIncomeAdjustments IncomeAdjustmentRequest[] @relation("IncomeAdjustmentReviewedBy")
  createdHistoricalImportSessions HistoricalImportSession[] @relation("HistoricalImportCreatedBy")
  corporateCallDurations CorporateCallDuration[] @relation("CorporateCallDurationManager")
  attendanceEvents AttendanceEvent[] @relation("AttendanceEventUser")
  attendanceDaySummaries AttendanceDaySummary[] @relation("AttendanceDaySummaryUser")
  attendanceAdjustmentSubjects AttendanceAdjustment[] @relation("AttendanceAdjustmentSubject")
  createdAttendanceAdjustments AttendanceAdjustment[] @relation("AttendanceAdjustmentCreatedBy")
  attendanceAdjustmentAudits AttendanceAdjustmentAudit[] @relation("AttendanceAdjustmentAuditActor")
  analyticsAiReports AnalyticsAiReport[]
  managedCalls Call[] @relation("CallManager")
  fallbackManagerImportSessions HistoricalImportSession[] @relation("HistoricalImportFallbackManager")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId, isActive])
  @@index([tenantId, amocrmResponsibleUserId])
  @@index([email])
  @@index([phone])
  @@index([amocrmResponsibleUserId])
  @@unique([tenantId, id]) // target of composite tenant-safe foreign keys
  @@map("users")
}

// Account linking: allow users to link multiple auth methods
model UserAuthLink {
  id        String   @id @default(uuid())
  userId    String
  provider  String   // phone, telegram
  providerId String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("user_auth_links")
}

// ============================================
// INTEGRATIONS
// ============================================

model Integration {
  id              String   @id @default(uuid())
  tenantId        String
  type            String   // amocrm, telegram, google_sheets, faceid_attendance, meta_ads
  status          String   @default("pending") // pending, active, error, disconnected
  config          Json?    // integration-specific config
  tokensEncrypted String?  // encrypted tokens (access_token, refresh_token)
  refreshToken    String?  // encrypted refresh token
  expiresAt       DateTime?
  lastSyncAt      DateTime?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telegramRecipients TelegramRecipient[]

  @@unique([tenantId, type])
  @@index([type, status])
  @@map("integrations")
}

model TelegramRecipient {
  id                 String   @id @default(uuid())
  tenantId           String
  integrationId      String
  chatId             String
  username           String?
  firstName          String?
  lastName           String?
  displayName        String
  started            Boolean  @default(false)
  selectedForReports Boolean  @default(false)
  startedAt          DateTime?
  lastSeenAt         DateTime?
  lastUpdateId       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, chatId])
  @@index([tenantId, started])
  @@index([tenantId, selectedForReports])
  @@map("telegram_recipients")
}

model MetaAdInsight {
  id           String   @id @default(uuid())
  tenantId     String
  date         DateTime
  accountId    String
  /// '' when Meta did not return the level (kept non-null so the unique key is null-safe)
  campaignId   String   @default("")
  campaignName String?
  adSetId      String   @default("")
  adSetName    String?
  adId         String   @default("")
  adName       String?
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  spend        Decimal  @default(0) @db.Decimal(18, 4)
  ctr          Decimal  @default(0) @db.Decimal(12, 6)
  cpc          Decimal  @default(0) @db.Decimal(18, 4)
  cpm          Decimal  @default(0) @db.Decimal(18, 4)
  leads        Int      @default(0)
  raw          Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, accountId, campaignId, adSetId, adId], map: "meta_ad_insights_tenant_date_account_campaign_adset_ad_key")
  @@index([tenantId, accountId, date])
  @@index([date])
  @@index([accountId])
  @@index([campaignId])
  @@map("meta_ad_insights")
}

model AnalyticsAiReport {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String?
  range         String
  dateFrom      DateTime
  dateTo        DateTime
  focus         String
  promptVersion String   @default("sales-intelligence-v1")
  model         String?
  inputSummary  Json?
  result        Json?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([dateFrom, dateTo])
  @@map("analytics_ai_reports")
}

// ============================================
// CRM DATA (LEADS & CONTACTS)
// ============================================

model Lead {
  id          String   @id @default(uuid())
  tenantId    String
  amocrmId    String?
  title       String
  contactId   String?
  status      String?  // lead status from AmoCRM
  pipelineId  String?
  /// amoCRM responsible user id (not a users.id), so no foreign key.
  responsibleUserId String?
  metadata    Json?    // additional lead data
  source      String?  // where lead came from
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])
  calls   Call[]

  @@index([amocrmId])
  @@unique([tenantId, amocrmId])
  @@index([contactId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, externalCreatedAt])
  @@index([tenantId, createdAt])
  @@index([externalCreatedAt])
  @@map("leads")
}

model Contact {
  id         String   @id @default(uuid())
  tenantId   String
  name       String?
  phone      String?
  email      String?
  externalIds Json?   // { amocrm_id: "...", telegram_id: "..." }
  // amoCRM contact id (also kept in externalIds.amocrm_id). Unique per tenant: the amoCRM webhook upserts by it.
  amocrmId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]
  calls  Call[]

  @@unique([tenantId, amocrmId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([phone])
  @@index([email])
  @@map("contacts")
}

// ============================================
// VOIP / CALLS
// ============================================

model Call {
  id            String   @id @default(uuid())
  tenantId      String
  provider      String   @default("unknown")
  callIdExternal String // external call ID from VoIP provider
  from          String   // caller number
  to            String   // called number
  direction     String   // inbound, outbound
  duration      Int?     // seconds
  status        String   // completed, failed, missed, busy
  recordingUrl  String?
  recordingId   String?
  metadata      Json?    // call quality metrics, etc.
  leadId        String?
  contactId     String?
  // The manager the call is counted for (from the amoCRM responsible user). Calls are attributed by this column only.
  managerUserId String?
  startedAt     DateTime
  endedAt       DateTime?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead?  @relation(fields: [leadId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  manager User?  @relation("CallManager", fields: [managerUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, provider, startedAt])
  @@index([tenantId, startedAt])
  @@index([tenantId, managerUserId, startedAt])
  @@index([provider])
  @@index([callIdExternal])
  @@index([from])
  @@index([to])
  @@index([leadId])
  @@index([contactId])
  @@unique([tenantId, provider, callIdExternal])
  @@index([startedAt])
  @@map("calls")
}

// ============================================
// NOTIFICATIONS & QUEUE
// ============================================

model Notification {
  id          String   @id @default(uuid())
  tenantId    String
  type        String   // telegram, email, sms
  channel     String?  // specific channel identifier
  payload     Json     // message content, recipient, etc.
  status      String   @default("pending") // pending, sent, failed, retrying
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  nextRetryAt DateTime?
  sentAt      DateTime?
  errorMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// WEBHOOKS
// ============================================

model WebhookEvent {
  id          String   @id @default(uuid())
  tenantId    String?
  source      String   // amocrm, telegram, faceid (older rows may hold the removed voip/utel sources)
  eventType   String
  idempotencyKey String?
  rawPayload  Json     // original webhook payload
  signature   String?  // webhook signature for verification
  processed   Boolean  @default(false)
  processedAt DateTime?
  errorMessage String?
  retryCount  Int      @default(0)
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([source, processed])
  @@index([source, idempotencyKey])
  @@unique([tenantId, source, idempotencyKey])
  @@index([createdAt])
  @@map("webhook_events")
}

// ============================================
// AUDIT & SECURITY
// ============================================

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String   // create, update, delete, login, etc.
  resource  String?  // lead, contact, integration, etc.
  resourceId String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// CUSTOMERS, COURSES, TARIFFS, INCOME
// ============================================

model Customer {
  id              String   @id @default(uuid())
  tenantId        String
  customerNumber  String
  name            String
  telegramUsername String?
  profileCourseId String?
  profileTariffId String?
  profileSubTariffId String?
  legacyProfileImportKey String?
  legacyProfileImportSource String?
  historicalImportSessionId String?
  legacyProfileMeta Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileCourse    Course?    @relation("CustomerProfileCourse", fields: [profileCourseId], references: [id], onDelete: SetNull)
  profileTariff    Tariff?    @relation("CustomerProfileTariff", fields: [profileTariffId], references: [id], onDelete: SetNull)
  profileSubTariff SubTariff? @relation("CustomerProfileSubTariff", fields: [profileSubTariffId], references: [id], onDelete: SetNull)
  historicalImportSession HistoricalImportSession? @relation(fields: [historicalImportSessionId], references: [id], onDelete: SetNull)
  incomes Income[]
  incomeAdjustmentRequests IncomeAdjustmentRequest[]

  @@unique([tenantId, customerNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, profileCourseId])
  @@index([tenantId, profileTariffId])
  @@index([tenantId, profileSubTariffId])
  @@index([customerNumber])
  @@index([profileCourseId])
  @@index([profileTariffId])
  @@index([profileSubTariffId])
  @@index([historicalImportSessionId])
  @@unique([tenantId, legacyProfileImportKey])
  @@unique([tenantId, id]) // target of composite tenant-safe foreign keys
  @@map("customers")
}

model Course {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  category  String   @default("offline") // online, offline, intensive, additional_service
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean  @default(true)
  isHiddenFromIncomeForm Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tariffs Tariff[]
  incomes Income[]
  incomeAdjustmentRequests IncomeAdjustmentRequest[] @relation("IncomeAdjustmentNewCourse")
  incomeAdjustmentRequestsAsPrevious IncomeAdjustmentRequest[] @relation("IncomeAdjustmentPreviousCourse")
  profileCustomers Customer[] @relation("CustomerProfileCourse")

  @@unique([tenantId, name])
  @@map("courses")
}

model Tariff {
  id        String   @id @default(uuid())
  tenantId  String
  courseId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  incomes Income[]
  subTariffs SubTariff[]
  incomeAdjustmentRequests IncomeAdjustmentRequest[] @relation("IncomeAdjustmentNewTariff")
  incomeAdjustmentRequestsAsPrevious IncomeAdjustmentRequest[] @relation("IncomeAdjustmentPreviousTariff")
  profileCustomers Customer[] @relation("CustomerProfileTariff")

  @@unique([tenantId, courseId, name])
  @@index([courseId])
  @@map("tariffs")
}

model SubTariff {
  id        String   @id @default(uuid())
  tenantId  String
  tariffId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tariff Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  profileCustomers Customer[] @relation("CustomerProfileSubTariff")

  @@unique([tenantId, tariffId, name])
  @@index([tariffId])
  @@map("sub_tariffs")
}

// MONEY UNITS: every money column in this schema (incomes, income_adjustment_requests, bonus_* amounts,
// customer/course prices, ...) is an Int holding whole so'm, with no fractional part. Postgres integer tops out at
// 2,147,483,647, so a single stored value is limited to about 2.1 billion so'm; a larger value fails on write
// (it is not silently truncated). Sums are computed in application code / BIGINT aggregates, not stored. Moving a
// column to BigInt or Decimal is a deliberate, separate migration.
model Income {
  id                 String   @id @default(uuid())
  tenantId           String
  customerId         String
  managerUserId      String
  type               String   // new_sale, repayment
  relatedDebtIncomeId String?
  courseId           String?
  tariffId           String?
  entryDate          DateTime
  deadline           DateTime?
  coursePriceAmount  Int?     // amount in whole currency units
  debtAmount         Int?     // source debt amount at creation time
  paymentAmount      Int      // paid amount
  remainingDebtAmount Int     // remaining debt after this transaction
  lifecycleStatus    String   @default("active") // active, pending_refund, refunded
  legacyImportKey    String?
  legacyImportSource String?
  historicalImportSessionId String?
  legacyImportMeta   Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Composite (tenantId, ...) keys: a row can only point at a parent of its own tenant.
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  manager  User     @relation("IncomeManager", fields: [tenantId, managerUserId], references: [tenantId, id], onDelete: Restrict)
  course   Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  tariff   Tariff?  @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  historicalImportSession HistoricalImportSession? @relation(fields: [historicalImportSessionId], references: [id], onDelete: SetNull)
  adjustmentRequests IncomeAdjustmentRequest[]

  relatedDebtIncome Income? @relation("DebtRepaymentSource", fields: [relatedDebtIncomeId], references: [id], onDelete: SetNull)
  repayments        Income[] @relation("DebtRepaymentSource")

  @@index([tenantId, entryDate])
  @@index([tenantId, lifecycleStatus, entryDate])
  @@index([tenantId, type, lifecycleStatus, entryDate])
  @@index([tenantId, managerUserId, entryDate])
  @@index([tenantId, managerUserId, lifecycleStatus, entryDate])
  @@index([tenantId, courseId, tariffId, entryDate])
  @@index([tenantId, relatedDebtIncomeId, lifecycleStatus])
  @@index([customerId])
  @@index([managerUserId])
  @@index([type])
  @@index([entryDate])
  @@index([remainingDebtAmount])
  @@index([lifecycleStatus])
  @@index([relatedDebtIncomeId])
  @@index([historicalImportSessionId])
  @@unique([tenantId, legacyImportKey])
  @@unique([tenantId, id]) // target of composite tenant-safe foreign keys
  @@map("incomes")
}

// The historical income import feature code was removed (it had been disabled). The model and the
// customers/incomes historicalImportSessionId columns stay because existing rows reference them.
model HistoricalImportSession {
  id                 String   @id @default(uuid())
  tenantId           String
  createdByUserId    String
  status             String   @default("prepared") // prepared, running, cancelling, cancelled, failed, completed
  fallbackManagerUserId String?
  sourceFiles        Json?
  managerAliasMap    Json?
  incomeRows         Json?
  customerRows       Json?
  preview            Json?
  progress           Json?
  failureReport      Json?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy          User     @relation("HistoricalImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  fallbackManager    User?    @relation("HistoricalImportFallbackManager", fields: [fallbackManagerUserId], references: [id], onDelete: SetNull)
  customers          Customer[]
  incomes            Income[]

  @@index([tenantId])
  @@index([createdByUserId])
  @@index([status])
  @@map("historical_import_sessions")
}

model IncomeAdjustmentRequest {
  id               String   @id @default(uuid())
  tenantId         String
  type             String   // refund, tariff_change
  status           String   @default("pending") // pending, approved, rejected
  incomeId         String
  customerId       String
  requestedByUserId String
  reviewedByUserId String?
  reason           String?
  reviewNote       String?
  requestedAmount  Int?
  refundCardNumber String?  @db.VarChar(16)
  newCourseId      String?
  newTariffId      String?
  newAgreementAmount Int?
  previousCourseId String?
  previousTariffId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reviewedAt       DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Composite (tenantId, ...) keys: a request can only point at rows of its own tenant.
  income      Income   @relation(fields: [tenantId, incomeId], references: [tenantId, id], onDelete: Cascade)
  customer    Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  requestedBy User     @relation("IncomeAdjustmentRequestedBy", fields: [tenantId, requestedByUserId], references: [tenantId, id], onDelete: Restrict)
  reviewedBy  User?    @relation("IncomeAdjustmentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  newCourse   Course?  @relation("IncomeAdjustmentNewCourse", fields: [newCourseId], references: [id], onDelete: SetNull)
  newTariff   Tariff?  @relation("IncomeAdjustmentNewTariff", fields: [newTariffId], references: [id], onDelete: SetNull)
  previousCourse Course? @relation("IncomeAdjustmentPreviousCourse", fields: [previousCourseId], references: [id], onDelete: SetNull)
  previousTariff Tariff? @relation("IncomeAdjustmentPreviousTariff", fields: [previousTariffId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([incomeId])
  @@index([customerId])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@index([createdAt])
  @@map("income_adjustment_requests")
}

/// createdByUserId is an audit value (who saved the policy), kept without a foreign key
/// so the history survives user deletion.
model BonusPolicyVersion {
  id              String   @id @default(uuid())
  tenantId        String
  effectiveMonth  DateTime
  policy          Json
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshots BonusMonthSnapshot[]

  @@unique([tenantId, effectiveMonth])
  @@map("bonus_policy_versions")
}

/// Frozen month result. finalizedByUserId (may be the system finalizer id) is a history
/// value without a foreign key.
model BonusMonthSnapshot {
  id              String   @id @default(uuid())
  tenantId        String
  month            DateTime
  policyVersionId String?
  policy           Json
  sourceDigest     String
  totalBonusAmount Int      @default(0)
  finalizedByUserId String
  finalizedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyVersion BonusPolicyVersion?   @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)
  lines         BonusSnapshotLine[]
  items         BonusSnapshotItem[]
  adjustments   BonusAdjustment[]

  @@unique([tenantId, month])
  @@index([tenantId, finalizedAt])
  @@unique([tenantId, id]) // target of composite tenant-safe foreign keys
  @@map("bonus_month_snapshots")
}

/// Snapshot rows are history: agentUserId and courseId keep the values at finalization
/// time and intentionally have no foreign keys (users/courses may be deleted later).
model BonusSnapshotLine {
  id               String   @id @default(uuid())
  tenantId         String
  snapshotId       String
  groupKey         String
  agentUserId      String
  courseId         String?
  category         String
  calculationMode  String
  qualifyingAmount Int
  appliedPercent   Decimal  @db.Decimal(7, 4) // percent, e.g. 7.5000
  bonusAmount      Int
  sourceCount      Int      @default(0)
  createdAt        DateTime @default(now())

  snapshot BonusMonthSnapshot @relation(fields: [tenantId, snapshotId], references: [tenantId, id], onDelete: Cascade)

  @@unique([snapshotId, groupKey])
  @@index([tenantId, agentUserId])
  @@index([tenantId, courseId])
  @@map("bonus_snapshot_lines")
}

/// History values (sourceIncomeId, sourceSaleId, agentUserId, courseId): no foreign keys
/// on purpose, the snapshot must survive later edits and deletions.
model BonusSnapshotItem {
  id              String   @id @default(uuid())
  tenantId        String
  snapshotId      String
  sourceKey       String
  sourceIncomeId  String
  sourceSaleId    String
  agentUserId     String
  courseId        String?
  category        String
  calculationMode String
  eventDate       DateTime
  baseAmount      Int
  appliedPercent  Decimal @db.Decimal(7, 4) // percent, e.g. 7.5000
  bonusAmount     Int
  metadata        Json?
  createdAt       DateTime @default(now())

  snapshot BonusMonthSnapshot @relation(fields: [tenantId, snapshotId], references: [tenantId, id], onDelete: Cascade)

  @@unique([snapshotId, sourceKey])
  @@index([tenantId, eventDate])
  @@index([tenantId, agentUserId, eventDate])
  @@index([tenantId, courseId, eventDate])
  @@map("bonus_snapshot_items")
}

/// agentUserId, courseId and reviewedByUserId are history values without foreign keys.
model BonusAdjustment {
  id                String   @id @default(uuid())
  tenantId          String
  snapshotId        String
  groupKey          String
  agentUserId       String
  courseId          String?
  category          String
  deltaAmount       Int
  outstandingAmount Int
  status            String   @default("pending")
  sourceDigest      String
  payoutMonth       DateTime?
  reviewedByUserId  String?
  reviewNote        String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshot     BonusMonthSnapshot            @relation(fields: [tenantId, snapshotId], references: [tenantId, id], onDelete: Cascade)
  audits       BonusAdjustmentAudit[]
  applications BonusAdjustmentApplication[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, agentUserId, payoutMonth])
  // At most one pending adjustment per (snapshotId, groupKey): a partial unique index created in migration
  // 20261121110000 (WHERE status = 'pending'), which Prisma's schema language cannot express.
  @@index([snapshotId, groupKey])
  @@unique([tenantId, id]) // target of composite tenant-safe foreign keys
  @@map("bonus_adjustments")
}

/// A finalized-bonus reconciliation still owed to a tenant. Written in the same transaction as the money change that
/// needs it, deleted once reconcileFinalizedBonusMonths has succeeded; the bonus reconcile sweeper retries what is
/// left, so a failed or interrupted reconcile is never lost. attempts/lastError show why one is stuck.
model BonusReconcileRequest {
  id            String    @id @default(uuid())
  tenantId      String
  reason        String
  attempts      Int       @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("bonus_reconcile_requests")
}

/// Audit trail: actorUserId is a history value without a foreign key.
model BonusAdjustmentAudit {
  id          String   @id @default(uuid())
  tenantId    String
  adjustmentId String
  action      String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adjustment BonusAdjustment @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([adjustmentId, createdAt])
  @@map("bonus_adjustment_audits")
}

model BonusAdjustmentApplication {
  id           String   @id @default(uuid())
  tenantId     String
  adjustmentId String
  payrollMonth DateTime
  amount       Int
  createdAt    DateTime @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adjustment BonusAdjustment @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([adjustmentId, payrollMonth])
  @@index([tenantId, payrollMonth])
  @@map("bonus_adjustment_applications")
}

model CorporateCallDuration {
  id              String   @id @default(uuid())
  tenantId        String
  managerUserId   String
  callDate        DateTime
  durationSeconds Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager  User   @relation("CorporateCallDurationManager", fields: [managerUserId], references: [id], onDelete: Cascade)

  @@unique([tenantId, managerUserId, callDate])
  @@index([managerUserId])
  @@index([callDate])
  @@map("corporate_call_durations")
}

model AttendanceEvent {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String?
  externalUserId String?
  externalPhone  String?
  firstName      String?
  lastName       String?
  externalRole   String?
  eventType      String
  action         String   // IN, OUT
  eventAt        DateTime
  localDate      String   // YYYY-MM-DD in Asia/Tashkent
  localTime      String?
  source         String   @default("FACE_ID")
  branchName     String?
  latitude       Float?
  longitude      Float?
  lateMinutes    Int      @default(0)
  idempotencyKey String?
  rawPayload     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation("AttendanceEventUser", fields: [userId], references: [id], onDelete: SetNull)
  adjustments AttendanceAdjustment[]

  @@unique([tenantId, idempotencyKey])
  @@index([userId])
  @@index([localDate])
  @@index([eventAt])
  @@index([eventType, action])
  @@map("attendance_events")
}

model AttendanceDaySummary {
  id               String   @id @default(uuid())
  tenantId         String
  userId           String
  summaryDate      String   // YYYY-MM-DD in Asia/Tashkent
  workedSeconds    Int      @default(0)
  requiredSeconds  Int      @default(32400)
  missingSeconds   Int      @default(0)
  lateMinutes      Int      @default(0)
  lateCount        Int      @default(0)
  absence          Boolean  @default(false)
  unmatchedInCount Int      @default(0)
  unmatchedOutCount Int     @default(0)
  anomalyCount     Int      @default(0)
  firstInAt        DateTime?
  lastOutAt        DateTime?
  sourceUpdatedAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("AttendanceDaySummaryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, summaryDate])
  @@index([userId])
  @@index([summaryDate])
  @@index([tenantId, summaryDate])
  @@map("attendance_day_summaries")
}

model AttendanceAdjustment {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String?
  eventId         String?
  summaryDate     String?
  action          String
  reason          String
  beforeData      Json?
  afterData       Json?
  createdByUserId String
  createdAt       DateTime @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?           @relation("AttendanceAdjustmentSubject", fields: [userId], references: [id], onDelete: SetNull)
  event     AttendanceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy User            @relation("AttendanceAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  auditEntries AttendanceAdjustmentAudit[]

  @@index([tenantId])
  @@index([userId])
  @@index([eventId])
  @@index([summaryDate])
  @@index([createdByUserId])
  @@map("attendance_adjustments")
}

model AttendanceAdjustmentAudit {
  id           String   @id @default(uuid())
  adjustmentId String
  tenantId     String
  actorUserId  String
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  adjustment AttendanceAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User                 @relation("AttendanceAdjustmentAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([adjustmentId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("attendance_adjustment_audits")
}

/// amoCRM tasks copied by the background snapshot job (services/integrations/amocrm-activity-snapshot.ts),
/// so pages read them from the database instead of paging amoCRM. `payload` is the task as amoCRM sent it.
model AmocrmTask {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text")) // as created by 20261117120000
  tenantId          String
  amocrmId          String
  /// amoCRM user id (not a users.id), so no foreign key.
  responsibleUserId String?
  entityType        String?
  entityId          String?
  isCompleted       Boolean   @default(false)
  completeTill      DateTime?
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  payload           Json
  syncedAt          DateTime  @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, amocrmId])
  // Name as created by 20261117120000 (Postgres truncates identifiers to 63 characters).
  @@index([tenantId, responsibleUserId, isCompleted, completeTill], map: "amocrm_tasks_tenantId_responsibleUserId_isCompleted_completeTil")
  @@map("amocrm_tasks")
}

/// amoCRM lead events (notes, stage changes, …) copied by the snapshot job. Events never change.
model AmocrmEvent {
  id                String   @id @default(dbgenerated("(gen_random_uuid())::text")) // as created by 20261117120000
  tenantId          String
  amocrmId          String
  type              String?
  entityType        String?
  entityId          String?
  /// amoCRM user id of the actor (not a users.id), so no foreign key.
  createdBy         String?
  externalCreatedAt DateTime
  payload           Json

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, amocrmId])
  @@index([tenantId, externalCreatedAt])
  @@index([tenantId, createdBy, externalCreatedAt])
  @@map("amocrm_events")
}

/// amoCRM reference data copied by the snapshot job: kind = users | pipelines | lead_custom_fields.
model AmocrmReference {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text")) // as created by 20261117120000
  tenantId    String
  kind        String
  payload     Json
  refreshedAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind])
  @@map("amocrm_reference")
}
